# AI Codebase Assistant Configuration
PROJECT_NAME="AI Codebase Assistant"
VERSION="0.1.0"
API_PREFIX="/api"
HOST="127.0.0.1"
PORT=8000

# Scanner Settings
MAX_FILE_SIZE_BYTES=1048576

# Chunker Settings
CHUNK_SIZE_LINES=60
CHUNK_OVERLAP_LINES=15

# RAG & Embedding Settings
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
INDEX_STORAGE_DIR=".index"
DEFAULT_TOP_K=5
EMBEDDING_BATCH_SIZE=32

# Gemini LLM Settings
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
